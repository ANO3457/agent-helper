# The isolated browser for the web page reader (docs/decisions/0028). One image for two containers: the
# Camoufox browser server (`python -m agent_helper.browser_server`) and the browse gateway
# (`python -m agent_helper.browse_gateway`), so the Playwright client and server always match.
# Base image pinned by digest, as in the service's Dockerfile.
ARG BASE_REGISTRY=docker.io/library
FROM ${BASE_REGISTRY}/python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/home/app

WORKDIR /app
COPY requirements.lock requirements-browser.txt ./
# The service's own dependencies with hashes; then Camoufox and the Playwright version it supports, pinned
# exactly. Update both together and deliberately (Camoufox keeps a ceiling on Playwright).
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements.lock \
    && pip install --no-cache-dir -r requirements-browser.txt \
    && python -m playwright install-deps firefox \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home --home-dir /home/app app
COPY agent_helper ./agent_helper

USER app
# The browser build Camoufox is paired with, fetched once at build time into the app user's cache.
RUN python -m camoufox fetch

# No default command: the compose file starts either the browser server or the gateway.
