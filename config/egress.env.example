# Egress proxy of the web page reader (docs/decisions/0029). Example only: copy outside the repository,
# adapt, never commit the live file. The proxy gets no secrets.

# The service's public URL; its host is refused
PUBLIC_BASE_URL=https://<own-domain>
# Required, the proxy does not start without one of them: the operator's own public addresses, so a page can
# never hairpin back in through the router or the reverse proxy.
# With IPv6, list the whole prefix the provider delegates (often a /56 or /48), not just the router's
# address: devices behind the router have global addresses of their own in it, and those count as public.
# EGRESS_DENY_NETS=<own public IPv4 address>/32,<own delegated IPv6 prefix>/56
# Names whose current addresses are refused, re-resolved every 5 minutes (the dynamic DNS name of the
# operator's connection, so a changing public address stays refused)
# EGRESS_DENY_ADDRESSES_OF=<own-ddns-name>
# Only when the proxy leaves through an address that is not the operator's (a VPN): then neither is needed.
# EGRESS_NO_OWN_ADDRESS=0
# The operator's own names (exact or *.suffix)
# EGRESS_DENY_DOMAINS=<own-domain>,*.<own-domain>
# Listen only on the browser's network (its address there, see the compose file), never on 0.0.0.0 behind
# a VPN, where 0.0.0.0 would include the tunnel.
EGRESS_LISTEN_HOST=
# EGRESS_ALLOWED_PORTS=80,443
# EGRESS_MAX_TUNNELS=64
LOG_LEVEL=info
