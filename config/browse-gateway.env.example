# Browse gateway of the web page reader (docs/decisions/0029). Example only: copy outside the repository,
# adapt, never commit the live file. Only the gateway gets this file.

# The same random value as BROWSE_SECRET in the service's app.env (at least 32 characters)
BROWSE_SECRET=
# The same random path as in browser.env (at least 16 characters); it is what admits the gateway
BROWSER_WS_PATH=
# The service's public URL; its host is never read
PUBLIC_BASE_URL=https://<own-domain>
# Sites never read (exact names or *.suffix), the same list as in the service
# BROWSE_DENY_DOMAINS=
# BROWSE_CONCURRENCY=2
# BROWSE_TIMEOUT_SECONDS=30
LOG_LEVEL=info
