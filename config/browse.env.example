# Web page reader (docs/decisions/0028). Example only: copy outside the repository, adapt, never commit the
# live file. Shared by the egress proxy, the browser and the gateway; the service needs only the BROWSE_*
# lines marked "service".

# service + gateway: the same random value on both sides (at least 32 characters)
BROWSE_SECRET=
# browser + gateway: a random path segment of at least 16 characters; it is what admits the gateway
BROWSER_WS_PATH=
# all: the service's public URL; its host is never read or contacted
PUBLIC_BASE_URL=https://<own-domain>

# --- service only (in app.env) ---
# BROWSE_MODE=off               # `on` to offer the reader; `off` and a restart is the kill switch
# BROWSE_GATEWAY_URL=http://browse-gateway:8095
# BROWSE_PER_MINUTE=3
# BROWSE_PER_DAY=30
# BROWSE_PER_DOMAIN_PER_MINUTE=6
# BROWSE_GLOBAL_PER_DAY=300
# BROWSE_CONCURRENCY=2
# BROWSE_TIMEOUT_SECONDS=30
# BROWSE_DENY_DOMAINS=          # sites never read (exact names or *.suffix), also in the gateway

# --- egress proxy ---
# The operator's own names and networks, never contacted whatever DNS says. Keep them only in the live file.
# EGRESS_DENY_DOMAINS=<own-domain>,*.<own-domain>
# EGRESS_DENY_NETS=<own public networks, CIDR>
# Names whose current addresses are refused, re-resolved every 5 minutes (the dynamic DNS name of the
# operator's connection, so a changing public address stays refused)
# EGRESS_DENY_ADDRESSES_OF=<own-ddns-name>
# EGRESS_ALLOWED_PORTS=80,443
# EGRESS_MAX_TUNNELS=64
LOG_LEVEL=info
